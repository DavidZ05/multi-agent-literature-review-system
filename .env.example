# Default mode is fully local and deterministic. No API key is required.
AGENT_BACKEND=deterministic
AGENT_API_MODE=single

# Option A: single API profile shared by all agents.
# AGENT_BACKEND=api
# AGENT_API_MODE=single
# AGENT_API_BASE_URL=https://api.example.com/v1
# AGENT_API_KEY=replace-with-your-key
# AGENT_MODEL=replace-with-model-name

# Option B: multi-agent API profile.
# Agents inherit the default API settings below unless an agent-specific value
# is provided. This is a configuration interface only; the current submission
# still runs deterministic logic unless API calling is implemented later.
# AGENT_BACKEND=api
# AGENT_API_MODE=multi
# WRITER_AGENT_MODEL=stronger-writer-model
# WRITER_AGENT_TEMPERATURE=0.4
# REVIEWER_AGENT_MODEL=stronger-reviewer-model
# REVIEWER_AGENT_TEMPERATURE=0.0
# POLISH_AGENT_MODEL=fast-polish-model
# POLISH_AGENT_TEMPERATURE=0.2

AGENT_API_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
AGENT_TEMPERATURE=0.2
AGENT_TIMEOUT_SECONDS=60

# Supported per-agent override prefixes in multi mode:
# SEARCH_AGENT_
# WRITER_AGENT_
# REVIEWER_AGENT_
# DOMAIN_EXPERT_AGENT_
# STRUCTURE_MENTOR_AGENT_
# REVIEW_SYNTHESIZER_AGENT_
# POLISH_AGENT_
# FINAL_VERIFICATION_AGENT_
# EVALUATION_REFLECTION_AGENT_
#
# Supported suffixes:
# API_BASE_URL, API_KEY, MODEL, TEMPERATURE, TIMEOUT_SECONDS
